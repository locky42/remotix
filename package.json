{
  "name": "tentacle",
  "displayName": "%ext.displayName%",
  "description": "%ext.description%",
  "version": "1.3.4",
  "publisher": "locky42",
  "repository": {
    "type": "git",
    "url": "https://github.com/locky42/tentacle.git"
  },
  "homepage": "https://github.com/locky42/tentacle#readme",
  "bugs": {
    "url": "https://github.com/locky42/tentacle/issues"
  },
  "icon": "media/Tentacle-icon-128x128.png",
  "engines": {
    "vscode": ">=1.70.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "ftp",
    "ssh",
    "sftp",
    "remote",
    "file-manager"
  ],
  "activationEvents": [
    "onCommand:tentacle.moreActions",

    "onCommand:tentacle.export",
    "onCommand:tentacle.import",
    "onCommand:tentacle.importSshConfig",

    "onCommand:tentacle.addConnection",
    "onCommand:tentacle.editConnection",
    "onCommand:tentacle.openSshTerminal",
    "onCommand:tentacle.upload",
    "onCommand:tentacle.editFile",
    "onCommand:tentacle.deleteFile",
    "onCommand:tentacle.rename",
    "onCommand:tentacle.copyPath",
    "onCommand:tentacle.importFileZilla",
    "onCommand:tentacle.deleteConnection",
    "onCommand:tentacle.closeConnection",
    "onCommand:tentacle.setLanguage",
    "onCommand:tentacle.openSettings",
    "onCommand:tentacle.createFile",
    "onCommand:tentacle.createFolder",
    "onCommand:tentacle.refresh",
    "onCommand:tentacle.copyItem",
    "onCommand:tentacle.pasteItem",
    "onCommand:tentacle.changePermissions",
    "onCommand:tentacle.showProperties",
    "onCommand:tentacle.downloadFolderArchive"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "tentacle.expandConnectionOnDoubleClick",
        "title": "Expand Connection"
      },
      {
        "command": "tentacle.addConnection",
        "title": "%command.addConnection%",
        "icon": "$(add)"
      },
      {
        "command": "tentacle.editConnection",
        "title": "%command.editConnection%",
        "icon": "$(edit)"
      },
      {
        "command": "tentacle.deleteConnection",
        "title": "%command.deleteConnection%",
        "icon": "$(trash)"
      },
      {
        "command": "tentacle.closeConnection",
        "title": "%command.closeConnection%",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "tentacle.openSshTerminal",
        "title": "%command.openSshTerminal%",
        "icon": "$(terminal)"
      },
      {
        "command": "tentacle.editFile",
        "title": "%command.editFile%",
        "icon": "$(edit)"
      },
      {
        "command": "tentacle.upload",
        "title": "%command.upload%",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "tentacle.download",
        "title": "%command.download%",
        "icon": "$(cloud-download)"
      },
      {
        "command": "tentacle.downloadFolderArchive",
        "title": "%command.downloadFolderArchive%",
        "icon": "$(package)"
      },
      {
        "command": "tentacle.rename",
        "title": "%command.rename%",
        "icon": "$(edit)"
      },
      {
        "command": "tentacle.deleteFile",
        "title": "%command.deleteFile%",
        "icon": "$(trash)"
      },
      {
        "command": "tentacle.copyPath",
        "title": "%command.copyPath%"
      },
      {
        "command": "tentacle.export",
        "title": "%command.export%"
      },
      {
        "command": "tentacle.import",
        "title": "%command.import%"
      },
      {
        "command": "tentacle.importSshConfig",
        "title": "%command.importSshConfig%"
      },
      {
        "command": "tentacle.importFileZilla",
        "title": "%command.importFileZilla%"
      },
      {
        "command": "tentacle.setLanguage",
        "title": "%command.setLanguage%",
        "icon": "$(globe)"
      },
      {
        "command": "tentacle.openSettings",
        "title": "%command.openSettings%",
        "icon": "$(settings-gear)"
      },
      {
        "command": "tentacle.moreActions",
        "title": "..."
      },
      {
        "command": "tentacle.createFile",
        "title": "%command.createFile%",
        "icon": "$(new-file)"
      },
      {
        "command": "tentacle.createFolder",
        "title": "%command.createFolder%",
        "icon": "$(new-folder)"
      },
      {
        "command": "tentacle.refresh",
        "title": "%command.refresh%",
        "icon": "$(refresh)"
      },
      {
        "command": "tentacle.copyItem",
        "title": "%command.copyItem%",
        "icon": "$(copy)"
      },
      {
        "command": "tentacle.pasteItem",
        "title": "%command.pasteItem%",
        "icon": "$(clippy)"
      },
      {
        "command": "tentacle.changePermissions",
        "title": "%command.changePermissions%",
        "icon": "$(settings-gear)"
      },
      {
        "command": "tentacle.showProperties",
        "title": "%command.showProperties%",
        "icon": "$(info)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "tentacle.addConnection",
          "when": "view == tentacleView",
          "group": "navigation@1"
        },
        {
          "command": "tentacle.openSettings",
          "when": "view == tentacleView",
          "group": "navigation@2",
          "icon": "$(settings-gear)"
        },
        {
          "command": "tentacle.moreActions",
          "when": "view == tentacleView",
          "group": "navigation@3",
          "icon": "$(ellipsis)"
        }
      ],
      "view/item/context": [
        {
          "command": "tentacle.refresh",
          "when": "view == tentacleView && (viewItem == ssh-folder || viewItem == ftp-folder || viewItem == connection || viewItem == connection-active)",
          "group": "inline",
          "icon": "$(refresh)"
        },
        {
          "command": "tentacle.closeConnection",
          "when": "view == tentacleView && (viewItem == connection || viewItem == connection-active)",
          "group": "inline",
          "icon": "$(debug-disconnect)"
        },
        {
          "command": "tentacle.createFile",
          "when": "view == tentacleView && (viewItem == ssh-folder || viewItem == ssh-file)",
          "group": "0_create@1"
        },
        {
          "command": "tentacle.createFolder",
          "when": "view == tentacleView && (viewItem == ssh-folder || viewItem == ssh-file)",
          "group": "0_create@2"
        },
        {
          "command": "tentacle.editFile",
          "when": "view == tentacleView && viewItem == ssh-file",
          "group": "0_edit_file@0"
        },
        {
          "command": "tentacle.openSshTerminal",
          "when": "view == tentacleView && (viewItem == connection || viewItem == connection-active)",
          "group": "navigation"
        },
        {
          "command": "tentacle.editConnection",
          "when": "view == tentacleView && (viewItem == connection || viewItem == connection-active)",
          "group": "1_connection"
        },
        {
          "command": "tentacle.closeConnection",
          "when": "view == tentacleView && (viewItem == connection || viewItem == connection-active)",
          "group": "1_connection"
        },
        {
          "command": "tentacle.copyPath",
          "when": "view == tentacleView && (viewItem == ssh-file || viewItem == ssh-folder || viewItem == ftp-file || viewItem == ftp-folder)",
          "group": "2_path"
        },
        {
          "command": "tentacle.showProperties",
          "when": "view == tentacleView && (viewItem == ssh-file || viewItem == ssh-folder)",
          "group": "2_path@2"
        },
        {
          "command": "tentacle.copyItem",
          "when": "view == tentacleView && (viewItem == ssh-file || viewItem == ssh-folder || viewItem == ftp-file || viewItem == ftp-folder)",
          "group": "4_modification@0"
        },
        {
          "command": "tentacle.pasteItem",
          "when": "view == tentacleView && (viewItem == ssh-folder || viewItem == ftp-folder)",
          "group": "4_modification@0"
        },
        {
          "command": "tentacle.upload",
          "when": "view == tentacleView && viewItem == ssh-folder",
          "group": "3_transfer@3"
        },
        {
          "command": "tentacle.upload",
          "when": "view == tentacleView && viewItem == ftp-folder",
          "group": "3_transfer@3"
        },
        {
          "command": "tentacle.download",
          "when": "view == tentacleView && (viewItem == ssh-file || viewItem == ssh-folder || viewItem == ftp-file || viewItem == ftp-folder)",
          "group": "3_transfer@1"
        },
        {
          "command": "tentacle.downloadFolderArchive",
          "when": "view == tentacleView && (viewItem == ssh-folder || viewItem == ssh-file)",
          "group": "3_transfer@2"
        },
        {
          "command": "tentacle.rename",
          "when": "view == tentacleView && (viewItem == ssh-file || viewItem == ssh-folder)",
          "group": "4_modification@1"
        },
        {
          "command": "tentacle.changePermissions",
          "when": "view == tentacleView && (viewItem == ssh-file || viewItem == ssh-folder)",
          "group": "5_permissions@1"
        },
        {
          "command": "tentacle.deleteFile",
          "when": "view == tentacleView && (viewItem == ssh-file || viewItem == ssh-folder)",
          "group": "4_modification@3"
        },
        {
          "command": "tentacle.deleteConnection",
          "when": "view == tentacleView && (viewItem == connection || viewItem == connection-active)",
          "group": "4_modification@3"
        },
        {
          "command": "tentacle.createFile",
          "when": "view == tentacleView && (viewItem == ftp-folder || viewItem == ftp-file)",
          "group": "0_create@1"
        },
        {
          "command": "tentacle.createFolder",
          "when": "view == tentacleView && (viewItem == ftp-folder || viewItem == ftp-file)",
          "group": "0_create@2"
        },
        {
          "command": "tentacle.editFile",
          "when": "view == tentacleView && viewItem == ftp-file",
          "group": "0_edit_file@1"
        },
        {
          "command": "tentacle.rename",
          "when": "view == tentacleView && (viewItem == ftp-file || viewItem == ftp-folder)",
          "group": "4_modification@1"
        },
        {
          "command": "tentacle.showProperties",
          "when": "view == tentacleView && (viewItem == ftp-file || viewItem == ftp-folder)",
          "group": "2_path@2"
        },
        {
          "command": "tentacle.changePermissions",
          "when": "view == tentacleView && (viewItem == ftp-file || viewItem == ftp-folder)",
          "group": "5_permissions@1"
        },
        {
          "command": "tentacle.deleteFile",
          "when": "view == tentacleView && (viewItem == ftp-file || viewItem == ftp-folder)",
          "group": "4_modification@3"
        }
      ]
    },
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "tentacle.language": {
          "type": "string",
          "default": "auto",
          "order": 1,
          "enum": [
            "auto",
            "en",
            "uk"
          ],
          "enumItemLabels": [
            "%config.language.item.auto%",
            "%config.language.item.en%",
            "%config.language.item.uk%"
          ],
          "description": "%config.language.description%"
        },
        "tentacle.ftpUploadConcurrency": {
          "type": "number",
          "default": 3,
          "order": 3,
          "minimum": 1,
          "maximum": 10,
          "description": "%config.ftpUploadConcurrency.description%"
        },
        "tentacle.ftpDownloadConcurrency": {
          "type": "number",
          "default": 3,
          "order": 2,
          "minimum": 1,
          "maximum": 10,
          "description": "%config.ftpDownloadConcurrency.description%"
        },
        "tentacle.sshUploadConcurrency": {
          "type": "number",
          "default": 3,
          "order": 5,
          "minimum": 1,
          "maximum": 10,
          "description": "%config.sshUploadConcurrency.description%"
        },
        "tentacle.sshDownloadConcurrency": {
          "type": "number",
          "default": 4,
          "order": 4,
          "minimum": 1,
          "maximum": 10,
          "description": "%config.sshDownloadConcurrency.description%"
        },
        "tentacle.logLevel": {
          "type": "string",
          "default": "error",
          "order": 6,
          "enum": [
            "error",
            "debug"
          ],
          "enumItemLabels": [
            "%config.logLevel.item.error%",
            "%config.logLevel.item.debug%"
          ],
          "description": "%config.logLevel.description%"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tentacle-activitybar",
          "title": "%view.container.title%",
          "icon": "media/Tentacle-icon-32x32.png"
        }
      ]
    },
    "views": {
      "tentacle-activitybar": [
        {
          "id": "tentacleView",
          "name": "%view.panel.name%",
          "icon": "media/Tentacle-icon-32x32.png",
          "dragAndDropController": true
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run copy-static && npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "copy-static": "rm -rf ./out/static && mkdir -p ./out/static && cp -rf ./src/static/* ./out/static/"
  },
  "dependencies": {
    "basic-ftp": "^5.2.0",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@types/node": "^16.0.0",
    "@types/ssh2": "^1.15.5",
    "@types/vscode": "^1.70.0",
    "eslint": "^8.0.0",
    "typescript": "^4.7.0"
  }
}
